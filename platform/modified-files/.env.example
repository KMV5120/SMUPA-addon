# 复制为 .env 并填入你自己的配置
# Django
DJANGO_SECRET_KEY=please-change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# 站点信息
SITE_NAME=心理协会工作平台
SITE_ORG_NAME=心理协会
SIMPLEUI_LOGO=/static/img/favicon.ico
FEEDBACK_EMAIL=your-email@example.com
SURVEY_API_KEY=change-me
CONSULTATION_ADDRESS=请在部署时配置
CONSULTATION_PHONE=请在部署时配置
WECHAT_OFFICIAL_ACCOUNT=请在部署时配置

# 邮件（SMTP）
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_FROM_NAME=Open Source Project

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 可选：直接指定 Celery broker 地址，未设置时自动使用上面的 Redis 配置
# CELERY_BROKER_URL=redis://127.0.0.1:6379/15

# wxpusher
WX_PUSHER_APP_TOKEN=

# 金山文档(预约推送)
WPS_FORM_ID=

# 腾讯云 COS
TENCENT_COS_ID=
TENCENT_COS_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

# 公众号 / 按摩功能外部地址
MASSAGE_EXTERNAL_URL=
MASSAGE_DEVICE_ID_BLUE=blue-device-id
MASSAGE_DEVICE_ID_GREEN=green-device-id

# ============================================================================
# 冥想室 —— 对外接口（同学预约页面跨域调用）
# ============================================================================
#
# ★★★ 这一项必须配，否则同学一点提交就报错 ★★★
#
# 同学预约页面托管在**另一个域名**上，浏览器会拦住跨域请求，
# 必须在这里把那个域名放行。填**页面所在的域名**（不是接口域名），
# 带协议、不带结尾斜杠；多个用英文逗号分隔。
#
# 留空 = 不开放任何跨域。
#
# 例：
#   MEDITATION_CORS_ORIGINS=https://med.your-domain.com
#   MEDITATION_CORS_ORIGINS=https://med.a.com,https://med-test.a.com
#
MEDITATION_CORS_ORIGINS=

# ============================================================================
# 冥想室 —— 微信小程序（可选，仅当将来要启用小程序时才需要）
# ============================================================================
# AppID 会写进小程序工程；AppSecret 只留在服务器，绝不下发
MEDITATION_MP_APPID=
MEDITATION_MP_SECRET=
# 小程序接口的 token 签名密钥，请设成一段随机字符串
MEDITATION_API_KEY=
# 冥想室本身（同学实际使用的地方）
MEDITATION_ROOM=410B
# 签到 / 签退值班室（纸质签到在这里，由值班员引导入室）
MEDITATION_CHECKIN_ROOM=412
# 对外免登录接口的按-IP 限流（每小时）。校园网 NAT 下同一出口 IP 代表很多人，
# 数值要取宽，否则会误拦正常同学；设为 0 关闭。
MEDITATION_SUBMIT_LIMIT_PER_IP=60
MEDITATION_LIST_LIMIT_PER_IP=300
# 可选：自定义《须知与承诺》正文（留空则用代码内默认文案）
MEDITATION_NOTICE_HTML=
